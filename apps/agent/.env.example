# ---- 生成モデル(OpenRouter一本化。ADR 0012) ----
# 無料枠のレート制限あり(20リクエスト/分・50リクエスト/日。
# 過去に$10以上のクレジット購入があるアカウントは1000リクエスト/日)。
# 無料(:free)モデルはOpenRouter側のプライバシー設定(無料モデルへのデータ提供許可)が
# 必要な場合がある。
# OpenRouterのAPIキー(https://openrouter.ai/keys で発行)
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# APIキーをSSM SecureStringから実行時取得する場合のパラメータ名。
# prodは /app/aws-mon/prod/openrouter-api-key をオーナーが手動作成し、Runtimeが取得する。
# OPENROUTER_API_KEY_PARAM=/app/aws-mon/prod/openrouter-api-key
# OpenRouterで使うモデルID(既定: nvidia/nemotron-3-ultra-550b-a55b:free)
# AGENT_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b:free
# OpenAI互換の別エンドポイントを使う場合のみ上書きする
# AGENT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- AWS 設定 ----
# SSM・CloudWatch を呼ぶリージョン。
# 生成モデルの推論はAWSを経由しない(OpenRouter一本化。ADR 0012)。
AWS_REGION=us-east-1

# 生成失敗時のリトライ回数。本番は3程度、コストを抑える検証時は0。
AGENT_GENERATE_RETRIES=3
# 日本語プレーンテキストの内容検証違反・品質欠陥(quality_checks.py)の検出時に
# 再生成する回数。既定1。使い切っても解消しなければ fail-closed で生成失敗にする。
# AGENT_CONTENT_RETRIES=1
# strands のモデル自動リトライ回数。既定3(strands既定の6は待ち合計約2分で、
# 日次枠切れの429は待っても回復しないため短縮している)。
# AGENT_MODEL_RETRY_ATTEMPTS=3

# ローカルHTTPサーバ（APIから呼び出す）
AGENT_HOST=127.0.0.1
AGENT_PORT=8090

# ---- AWSドキュメントMCP ----
# 生成前にAWS公式ドキュメントを調査してから出題する。0/false で無効化(調査なし生成)。
AGENT_DOCS_MCP=1
# MCPサーバーの起動コマンド。既定はrequirementsで同梱される console script
# (実行中のPythonと同じ環境から解決される)。uvx を使う場合は次のように差し替える:
# AGENT_DOCS_MCP_COMMAND=uvx awslabs.aws-documentation-mcp-server@latest
# 調査ターンが一過性のモデルエラーで落ちたときの再試行回数。既定2。
# AGENT_RESEARCH_RETRIES=2
# 1=調査未完了・調査失敗で生成を中止する(fail-closed。既定)。0=調査なしで続行する。
# 調査が失敗したまま生成すると本当に根拠のない問題ができるため、既定を切らないこと
# (issue #77 の決定)。ゲート撤去前は AGENT_GUARDRAIL_ENFORCE がこの制御を兼ねていた。
# AGENT_RESEARCH_ENFORCE=1
# 1回の調査で許す search_documentation / read_documentation の呼び出し上限。既定は各2。
# AGENT_DOCS_SEARCH_LIMIT=2
# AGENT_DOCS_READ_LIMIT=2

# ---- オブザーバビリティ(フェーズ3-1) ----
# OTel計装は ./scripts/run_server_otel.sh で起動したときだけ有効(通常起動では無計装)。
# 事前に ./scripts/setup_observability.sh で Transaction Search有効化とロググループ作成が必要。
# 以下は run_server_otel.sh が参照する(未設定なら既定値)。
# service.name の既定はローカル専用の -local 付き(コンソールで prod のトレースと区別するため)。
# prod と同一視したいときだけ aws-mon-quiz-agent に揃える。
# AGENT_OTEL_SERVICE_NAME=aws-mon-quiz-agent-local
# AGENT_OTEL_LOG_GROUP=/aws/aws-mon/quiz-agent
# AGENT_OTEL_LOG_STREAM=runtime-logs
# AGENT_OTEL_METRIC_NAMESPACE=aws-mon-agent
# 調査完了状況のEMFメトリクス(ResearchCount)。既定1。0/false/off で無効。
# 旧名 AGENT_GATE_METRICS も後方互換で受け付ける。
# AGENT_RESEARCH_METRICS=1

# ---- 自己整合ジャッジ(ADR 0018 の決定2) ----
# 生成後に別モデルで問題の内部整合を検品する。**未設定ならジャッジは動かない。**
# 現状は report-only で、defective でも生成物はそのまま返す。
# 生成モデル(AGENT_MODEL_ID)と同じIDにすると自己批評になり独立性が失われる
# (同一なら警告が出る)。prod は Terraform の agent_judge_model_id が注入する。
# AGENT_JUDGE_MODEL_ID=nvidia/nemotron-3-super-120b-a12b:free
#
# Guardrails 文脈的グラウンディングチェック(AGENT_GUARDRAIL_*)は ADR 0018 で撤去した。

# ---- AWS認証 ----
# SSM(APIキー取得)とCloudWatchにだけ使う。aws configure 済みなら不要で、
# プロファイルを指定する場合のみ設定する。
# AWS_PROFILE=default
#
# Bedrock APIキー(AWS_BEARER_TOKEN_BEDROCK)は ADR 0012 の Bedrock 推論経路撤去で不要。
