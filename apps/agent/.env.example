# ---- Bedrock / AWS 設定 ----
# 使用するBedrockのリージョン
AWS_REGION=us-east-1

# Bedrock のモデルID。
# クロスリージョン推論プロファイル経由の場合は "us." 接頭辞が必要なことが多い。
# 例: us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# 生成失敗時のリトライ回数。本番は3程度、コストを抑える検証時は0。
AGENT_GENERATE_RETRIES=3

# ローカルHTTPサーバ（APIから呼び出す）
AGENT_HOST=127.0.0.1
AGENT_PORT=8090

# ---- AWSドキュメントMCP ----
# 生成前にAWS公式ドキュメントを調査してから出題する。0/false で無効化(調査なし生成)。
AGENT_DOCS_MCP=1
# MCPサーバーの起動コマンド。既定はrequirementsで同梱される console script
# (実行中のPythonと同じ環境から解決される)。uvx を使う場合は次のように差し替える:
# AGENT_DOCS_MCP_COMMAND=uvx awslabs.aws-documentation-mcp-server@latest

# ---- オブザーバビリティ(フェーズ3-1) ----
# OTel計装は ./scripts/run_server_otel.sh で起動したときだけ有効(通常起動では無計装)。
# 事前に ./scripts/setup_observability.sh で Transaction Search有効化とロググループ作成が必要。
# 以下は run_server_otel.sh が参照する(未設定なら既定値)。
# AGENT_OTEL_SERVICE_NAME=aws-mon-quiz-agent
# AGENT_OTEL_LOG_GROUP=/aws/aws-mon/quiz-agent
# AGENT_OTEL_LOG_STREAM=runtime-logs
# AGENT_OTEL_METRIC_NAMESPACE=aws-mon-agent

# ---- Guardrails文脈的グラウンディングチェック(フェーズ3-3) ----
# 未設定なら無効(チェックなし)。./scripts/create_guardrail.py で作成したIDを設定する。
# AGENT_GUARDRAIL_ID=xxxxxxxx
# AGENT_GUARDRAIL_VERSION=DRAFT
# ブロック時に再生成する回数(初回を除く)。既定1。
# AGENT_GUARDRAIL_RETRIES=1
# 1=ブロックを強制(再生成しても失格なら生成失敗)。0=レポートのみ(結果は保存するが弾かない)。
# AGENT_GUARDRAIL_ENFORCE=1

# ---- 認証（どちらか一方）----
# 方法A: 通常のAWS認証情報（aws configure 済みなら不要。プロファイル指定する場合のみ）
# AWS_PROFILE=default

# 方法B: Bedrock APIキー（ベアラートークン）を使う場合
# AWS_BEARER_TOKEN_BEDROCK=xxxxxxxx
