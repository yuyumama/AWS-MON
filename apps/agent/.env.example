# ---- Bedrock / AWS 設定 ----
# 使用するBedrockのリージョン
AWS_REGION=us-east-1

# Bedrock のモデルID。
# クロスリージョン推論プロファイル経由の場合は "us." 接頭辞が必要なことが多い。
# 例: us.anthropic.claude-sonnet-4-6 / anthropic.claude-sonnet-4-6
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# ---- 認証（どちらか一方）----
# 方法A: 通常のAWS認証情報（aws configure 済みなら不要。プロファイル指定する場合のみ）
# AWS_PROFILE=default

# 方法B: Bedrock APIキー（ベアラートークン）を使う場合
# AWS_BEARER_TOKEN_BEDROCK=xxxxxxxx
