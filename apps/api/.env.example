# apps/api ローカル実行用の環境変数サンプル。
#   cp .env.example .env  してから: node --env-file=.env dist/index.js
#   （dev時は  `npx tsx watch --env-file=.env src/index.ts`  等でも読み込める）

PORT=8080
AWS_REGION=us-east-1

# ローカルインフラ(local/docker compose up -d)を使う場合に有効化する:
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# DynamoDB table names
QUESTIONS_TABLE=aws-mon-local-questions
SESSIONS_TABLE=aws-mon-local-sessions
USER_ACTIVITY_TABLE=aws-mon-local-user-activity
GENERATION_JOBS_TABLE=aws-mon-local-generation-jobs

# apps/agent のローカルHTTPサーバ
AGENT_BASE_URL=http://127.0.0.1:8090

# agent呼び出しのタイムアウト(ms、既定120000。ADR 0013)。
# 生成は実測で中央値190秒・最大429秒かかるため、jobを実際に実行する側では長めにする。
# jobのロック期限とworkerの時間予算はこの値から算出される(この値 + 30秒)。
AGENT_REQUEST_TIMEOUT_MS=600000

# 認証モード(ADR 0006)。dev = x-dev-user-id シム(ローカル専用) / cognito = JWT検証
AUTH_MODE=dev

# AUTH_MODE=cognito のとき必須。別AWSアカウントの既存User Poolの値を設定する。
# COGNITO_USER_POOL_ID=ap-northeast-1_XXXXXXXXX
# COGNITO_CLIENT_ID=AWS-MON用App ClientのID
# サービス利用そのものを許可するCognitoグループ名。既定 aws-mon-login(未所属は403)
# COGNITO_LOGIN_GROUP=aws-mon-login
# 生成権限(GENERATE/MIXED)を許可するCognitoグループ名。既定 aws-mon-generate
# COGNITO_GENERATE_GROUP=aws-mon-generate
