# apps/api ローカル実行用の環境変数サンプル。
#   cp .env.example .env  してから: node --env-file=.env dist/index.js
#   （dev時は  `npx tsx watch --env-file=.env src/index.ts`  等でも読み込める）

PORT=8080
AWS_REGION=us-east-1

# ローカルインフラ(local/docker compose up -d)を使う場合に有効化する:
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# DynamoDB table names
QUESTIONS_TABLE=aws-mon-local-questions
SESSIONS_TABLE=aws-mon-local-sessions
USER_ACTIVITY_TABLE=aws-mon-local-user-activity
GENERATION_JOBS_TABLE=aws-mon-local-generation-jobs
