# APIのベースURL。既定は /api (vite dev server が localhost:8080 へプロキシする)
VITE_API_BASE_URL=/api

# 認証モード(ADR 0006)。dev = x-dev-user-id devシム / cognito = 自前フォーム+SRPログイン
VITE_AUTH_MODE=dev

# devシム用ユーザーID(VITE_AUTH_MODE=dev のとき)。
# apps/api の x-dev-user-id ヘッダにそのまま渡る。
VITE_DEV_USER_ID=dev-user

# VITE_AUTH_MODE=cognito のとき必須。別AWSアカウントの既存User Poolの値を設定する。
# ログインは自前フォーム+SRP(amazon-cognito-identity-js)。ブラウザ内でSRP計算が
# 完結するため、App Clientは「クライアントシークレットなし」の public client(SPA用)
# である必要がある(シークレット付きApp Clientはブラウザから使えない)。
# Hosted UI専用に作られた既存App Clientを流用する場合は、シークレット無効・
# ALLOW_USER_SRP_AUTH 許可の両方を満たすものを選ぶこと(Hosted UIドメイン自体は不要)。
# VITE_COGNITO_USER_POOL_ID=ap-northeast-1_XXXXXXXXX
# VITE_COGNITO_CLIENT_ID=AWS-MON用App ClientのID(シークレットなしのpublic client)
