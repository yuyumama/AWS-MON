{
  "name": "aws-mon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build -w @aws-mon/shared && npm run build -w @aws-mon/api && npm run build -w @aws-mon/web",
    "format": "biome check --write .",
    "lint": "biome ci .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6"
  }
}
